# All optional. The app works without any of these.
# Merge Open Charge Map stations into Live GPS results (free key: https://openchargemap.org/site/develop/api)
OCM_API_KEY=
# Your own road-routing server for production traffic (default: public OSRM demo server)
OSRM_URL=
# Comma-separated Overpass (OpenStreetMap) endpoints, raced in parallel
OVERPASS_URLS=
